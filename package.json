{
  "name": "eslint-plugin-comment-budget",
  "version": "2.5.0",
  "description": "Cap a comment block at N words and keep decision-record prose out of the source.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "comment-budget-check": "./dist/bin/check-file.js",
    "comment-budget-seed": "./dist/bin/seed-budget.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.89.0",
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "oxc-parser": "^0.155.0"
  }
}
